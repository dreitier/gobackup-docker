// Builds gobackup from source with current dependencies, see ../Dockerfile.
// - gobackup itself is updated by .github/workflows/update-gobackup.yml together with ARG GOBACKUP_VERSION in the
//   Dockerfile: upstream's module path has no /v3 suffix, so its releases can only be required by commit
//   (pseudo-version) and Dependabot can't see them
// - all other modules are updated by Dependabot (.github/dependabot.yml)
module github.com/dreitier/gobackup-docker/gobackup

go 1.26.10

// replace directives of dependencies are ignored, so this one is copied from gobackup's own go.mod;
// check it when updating gobackup
replace github.com/jlaffaye/ftp => github.com/ncw/ftp v0.0.0-20221014105808-5da37698fc59

tool github.com/gobackup/gobackup

